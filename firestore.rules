rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid));
    }

    match /{colecao}/{documento} {
      allow read, write: if colecao in ['produtos', 'clientes', 'pedidos', 'pagamentos']
        && autorizado();
    }
    // Nenhum cliente pode conceder acesso a si mesmo ou listar autorizados.
    match /usuarios_autorizados/{uid} {
      allow read, write: if false;
    }
  }
}
